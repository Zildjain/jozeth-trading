# Copy this file to .env and replace the secret before real use.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
# Local MongoDB replica-set URI (requires the setup instructions in README.md)
MONGODB_URI=mongodb://127.0.0.1:27017/jozeth_trading?replicaSet=rs0&directConnection=true
# Development example only. Generate your own long random value for your environment.
JWT_SECRET=replace-this-with-a-random-secret-at-least-64-characters-long-before-use-2026
COOKIE_NAME=jozeth_session
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
